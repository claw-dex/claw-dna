{
    admin localhost:2019
    auto_https off
}

:8080 {
    # Streamlit dashboard (baseUrlPath=/app/ handles the prefix)
    handle /app/* {
        reverse_proxy localhost:8081
    }

    # File browser for entire filesystem
    handle /_/* {
        @blocked_credentials path /home/agent/.keepass /home/agent/.keepass/* /home/agent/.ssh /home/agent/.ssh/*
        respond @blocked_credentials 403

        root * /
        uri strip_prefix /_
        file_server browse {
            index .disabled
        }
    }

    # Generic webhook receiver
    handle /webhook/* {
        uri strip_prefix /webhook
        reverse_proxy localhost:8082
    }

    # External agent API (basic auth applied here, not in the service)
    handle /external-agent/* {
        uri strip_prefix /external-agent
        reverse_proxy localhost:8083
    }

    # Home page
    handle / {
        root * /agent
        rewrite * /index.html
        file_server
    }

    # Static files
    handle /web/* {
        root * /agent/web
        uri strip_prefix /web
        file_server
    }
}
